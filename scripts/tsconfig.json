{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "../.dumirc.ts",
    "../.dumi/plugin.ts",
    "../.dumi/theme/**/*.tsx",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
